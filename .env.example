# Online team play (Team Lobby → Online). Copy to .env to override the built-in project.
# The publishable key is safe to expose; never put a secret/service key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Accounts use this same project and need no other value here. The service key lives only in the
# Edge Function's environment on Supabase; never put it in .env or in the repo.
