{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "supabase/functions/account/rules.ts", "supabase/functions/account/handler.ts", "supabase/functions/account/handler.test.ts", "vite.config.ts", "vitest.setup.ts"]
}
